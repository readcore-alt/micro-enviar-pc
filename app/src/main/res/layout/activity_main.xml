<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mandar a PC"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Tarjeta de Confirmacion -->
        <LinearLayout
            android:id="@+id/cardConfirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archivo Listo Para Enviar"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="archivo.ext"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/txtTamanoArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso: 0 KB"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelarEnvio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnConfirmarEnvio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enviar" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seccion IP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP de la PC"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/txtIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="192.168.1.XX"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555" />

            <Button
                android:id="@+id/btnGuardarIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedir confirmación antes de enviar"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSeleccionarArchivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📎 Seleccionar archivo para enviar"
            android:layout_marginBottom="24dp" />

        <!-- TECLADO EN VIVO SIN MAYUSCULAS AUTOMATICAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨ Teclado en Vivo Instantáneo"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtTecladoEnVivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:hint="Escribe aquí (sin retardo ni mayúsculas forzadas)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- TEXTO EN BLOQUE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar texto largo en bloque"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtMensaje"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="top|start"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:hint="Pega párrafos largos aquí..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEnviarTexto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Enviar Bloque de Texto" />

    </LinearLayout>
</ScrollView>
